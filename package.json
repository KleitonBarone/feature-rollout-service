{
  "name": "feature-rollout-service",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --build packages/evaluation/tsconfig.build.json packages/service/tsconfig.build.json packages/sdk-node/tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "start": "node --env-file=.env packages/service/dist/main.js",
    "db:migrate": "node --env-file=.env packages/service/dist/main.js migrate",
    "benchmark": "node scripts/benchmark.mjs",
    "pack:release": "node scripts/pack.mjs",
    "dev:db": "node scripts/database.mjs",
    "dev:stop": "node scripts/database.mjs stop",
    "check": "tsc --build packages/evaluation/tsconfig.build.json packages/service/tsconfig.build.json packages/sdk-node/tsconfig.build.json && prettier --check . && eslint . && tsc --build && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "verify": "pnpm check && pnpm build && pnpm test:integration && pnpm test:e2e",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
